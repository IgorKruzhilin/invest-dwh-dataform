config {
  type: "view",
  schema: "df_stg",
  description: "MOEX board listing. One row per board and security. The source keeps the interval of board membership itself, in listing_from_date and listing_till_date.",
  tags: ["staging"],
  assertions: {
    uniqueKey: ["listing_key"],
    nonNull: ["listing_key", "board", "sec_id"]
  },
  columns: {
    listing_key: "Surrogate key: board and sec_id. The unique assertion holds our assumption that one ticker has one interval on one board.",
    market: "Market code taken from the Cloud Storage path, for example shares.",
    board: "Board code taken from the path, for example TQBR.",
    sec_id: "Security ticker on the board.",
    board_id: "Board code taken from the file. It must be equal to board.",
    short_name: "Short name of the security.",
    full_name: "Full name of the security, the legal name of the issue.",
    price_decimals: "Number of decimal places in the price on this board. This is price precision, not the listing level of the exchange.",
    listing_from_date: "First trade date of the security on the board.",
    listing_till_date: "Last trade date on the board. Never null: for a security that still trades it holds the last closed trade day.",
    extracted_at: "When the extract script wrote the file to Cloud Storage."
  }
}

select
	concat(board, '|', secid) listing_key
	, market
	, board
	, secid sec_id
	, boardid board_id
	, shortname short_name
	, name full_name
	, decimals price_decimals
	, history_from listing_from_date
	, history_till listing_till_date
	, _extracted_at extracted_at
from ${ref("moex_listing")}
